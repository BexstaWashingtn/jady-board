SERVER_HOST=127.0.0.1
SERVER_PORT=3000
DATABASE_URL=postgresql://jady:jady@127.0.0.1:5432/jady
DATABASE_SSL=false
# Temporary development identity for read-only board endpoints.
DEV_USER_ID=
# Production-style opaque bearer credentials as JSON. Do not combine with DEV_USER_ID.
API_BEARER_IDENTITIES=
# Explicit browser origin allowed to call the API. Empty means same-origin only.
CORS_ORIGIN=http://127.0.0.1:4173
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
